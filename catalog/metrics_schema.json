{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jhsfhtls/semantic-bi-nl2sql-gateway/catalog/metrics_schema.json",
  "title": "Semantic BI & NL2SQL Metrics Catalog Schema",
  "description": "Strict contract governing semantic models, cardinality-checked allowed joins, security firewall allowlists/blocklists, and certified BI metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "default_dialect",
    "security",
    "semantic_models",
    "allowed_joins",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the catalog contract."
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "default_dialect": {
      "type": "string",
      "enum": ["duckdb"]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_limit",
        "max_limit",
        "query_timeout_seconds",
        "blocked_sensitive_columns",
        "blocked_column_patterns",
        "allowed_functions"
      ],
      "properties": {
        "default_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "query_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "blocked_sensitive_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "blocked_column_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "semantic_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "table",
          "grain",
          "primary_key",
          "description",
          "columns"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "role": {
            "type": "string",
            "enum": ["fact", "dimension"]
          },
          "table": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
          },
          "grain": {
            "type": "string",
            "minLength": 1
          },
          "primary_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "time_dimension": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source_lakehouse": {
            "type": ["string", "null"]
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "role", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^(VARCHAR|INTEGER|BIGINT|BOOLEAN|DATE|TIMESTAMP|DOUBLE|DECIMAL\\([0-9]+,[0-9]+\\))$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "primary_key",
                    "foreign_key",
                    "time_dimension",
                    "dimension",
                    "measure",
                    "attribute"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 3
                },
                "sensitive": {
                  "type": "boolean"
                },
                "synonyms": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "allowed_joins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "left_model",
          "right_model",
          "left_key",
          "right_key",
          "join_type",
          "cardinality",
          "safe_for_aggregation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "left_model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "right_model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "left_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "right_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "join_type": {
            "type": "string",
            "enum": ["left", "inner"]
          },
          "cardinality": {
            "type": "string",
            "enum": ["many_to_one", "one_to_one"]
          },
          "safe_for_aggregation": {
            "type": "boolean"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "description",
          "model",
          "type",
          "format",
          "time_intelligence",
          "dimensions",
          "owner",
          "certified"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": ["simple", "ratio", "derived", "cumulative"]
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "numerator": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "display_folder": {
            "type": "string",
            "minLength": 1
          },
          "time_intelligence": {
            "type": "boolean"
          },
          "target_expression": {
            "type": ["string", "null"]
          },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "certified": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {"const": "ratio"}
              }
            },
            "then": {
              "required": ["numerator", "denominator"]
            },
            "else": {
              "required": ["expression"]
            }
          }
        ]
      }
    }
  }
}
